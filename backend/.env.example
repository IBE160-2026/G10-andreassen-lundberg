# Kopier til .env ved behov. .env skal aldri committes.
# Uten nøkkel brukes regelbaserte forklaringer i kodeskjelettet.

# Språkmodell velges i SCRUM-59. Tom verdi = regelbasert forklaring.
VAKTMATCH_LLM_PROVIDER=
VAKTMATCH_LLM_API_KEY=

# Valgfritt: annen mappe for demodatasett. Relative stier regnes fra backend/.
# VAKTMATCH_DATA_DIR=data/datasets

# Valgfritt: tillatte nettleseropprinnelser som JSON-liste.
# VAKTMATCH_CORS_ORIGINS=["http://localhost:5173"]
